{
  "manifest_version": 3,
  "key": "",
  "name": "Chat Replay · Twitch en YouTube",
  "short_name": "Chat Replay",
  "version": "1.9.0",
  "description": "Muestra el chat de Twitch (descargado con TwitchDownloader) sincronizado con los vídeos de YouTube. Hecho por @byalvaro__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Replay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://www.dropbox.com/*",
    "https://*.dropboxusercontent.com/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://cdn.frankerfacez.com/*",
    "https://static-cdn.jtvnw.net/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "app.html",
        "app.css",
        "app.js",
        "worker.js",
        "shared/*",
        "icons/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    },
    {
      "resources": [
        "bridge.html",
        "bridge.js",
        "shared/*"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://byalvaroo.github.io/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}